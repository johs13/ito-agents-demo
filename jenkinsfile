// =============================================================================
// Jenkins Pipeline - Gradle 빌드 스크립트
// =============================================================================
// 사용 전 체크리스트:
//   1. Windows 에이전트는 로컬 설치 Gradle(C:\gradle-9.7.1)을 절대 경로로 호출합니다.
//      - PATH 에 등록되어 있어도 Jenkins 서비스/에이전트가 PATH 변경 전에 시작되어
//        'gradle' 명령을 인식하지 못하는 문제를 회피합니다.
//      - Gradle Wrapper(gradlew)를 커밋한 후에는 "gradlew.bat" 으로 교체 가능합니다.
//   2. SonarQube 스테이지: Jenkins 관리 > System > SonarQube servers 에
//      'sonarqube' 라는 이름으로 서버가 등록되어 있어야 합니다. (Name 은 변경 가능)
//      SonarQube 를 사용하지 않으면 'SonarQube Analysis', 'Quality Gate' 스테이지를 삭제하세요.
// =============================================================================

// 크로스 플랫폼(Linux/Windows 에이전트 모두) 지원용 Gradle 실행 헬퍼
def gradleBuild(String args) {
    if (isUnix()) {
        sh "gradle ${args}"
    } else {
        bat "\"C:\\gradle-9.7.1\\bin\\gradle.bat\" ${args}"
    }
}

pipeline {
    agent any

    environment {
        // Gradle 캐시를 워크스페이스 안에 두어 빌드 간 캐시 재사용
        GRADLE_USER_HOME = "${WORKSPACE}/.gradle"
        // CI 환경에서는 데몬 사용 비권장
        GRADLE_OPTS = '-Dorg.gradle.daemon=false'
    }

    options {
        timestamps()                              // 콘솔 로그에 타임스탬프 표시
        buildDiscarder(logRotator(numToKeepStr: '10'))  // 최근 10개 빌드 기록만 보존
        timeout(time: 30, unit: 'MINUTES')        // 빌드 최대 30분 제한
        disableConcurrentBuilds()                 // 동시 빌드 방지
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                // clean build (테스트 제외 - 별도 스테이지에서 실행)
                gradleBuild('clean build -x test')
            }
        }

        stage('Test') {
            steps {
                gradleBuild('test')
            }
            post {
                always {
                    // JUnit 테스트 리포트를 Jenkins 에 게시 (Test Result 화면에서 확인 가능)
                    junit allowEmptyResults: true,
                          testResults: 'build/test-results/test/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                // Jenkins 시스템 설정에 등록된 SonarQube 서버 이름 ('sonarqube')
                withSonarQubeEnv('sonarqube') {
                    gradleBuild('sonar')
                }
            }
        }

        stage('Quality Gate') {
            steps {
                // SonarQube 품질 게이트 통과 여부 확인 (실패 시 파이프라인 중단)
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                // 빌드 결과물(build/libs/*.jar) 아카이브
                archiveArtifacts artifacts: 'build/libs/*.jar',
                                 fingerprint: true,
                                 allowEmptyArchive: false
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Gradle 빌드가 성공적으로 완료되었습니다.'
        }
        failure {
            echo 'FAILURE: Gradle 빌드가 실패했습니다. 로그를 확인하세요.'
        }
        unstable {
            echo 'UNSTABLE: 테스트 실패가 있습니다. Test Result 를 확인하세요.'
        }
        always {
            echo "BUILD RESULT: ${currentBuild.currentResult}"
            // 워크스페이스 정리가 필요하면 아래 주석 해제 (Workspace Cleanup 플러그인 필요)
            // cleanWs deleteDirs: true, notFailBuild: true
        }
    }
}